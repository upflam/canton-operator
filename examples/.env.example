# Copy to .env next to compose.yaml, then: docker compose up -d
# Every var has a default or is auto-detected — a minimal install can leave this empty.

# Seed scan the agent uses to discover Super Validators and reach consensus.
# Optional: when unset, the agent auto-detects it from the running validator container
# (SPLICE_APP_VALIDATOR_SCAN_ADDRESS). Set it explicitly only to override.
# SV_SEED_SCAN_URL=https://scan.sv-1.global.canton.network.digitalasset.com

# Slack incoming webhook for alerts and post-update notices (recommended).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Daily apply window "HH:MM-HH:MM". Empty = update any time.
# Recommended for production to avoid updates during peak hours.
# Wraps past midnight (e.g. 23:00-01:00).
# ROLLOUT_WINDOW=02:00-04:00
#
# Timezone for ROLLOUT_WINDOW (IANA name). Default UTC. This is independent of
# the container clock, so set your local zone or the window is read in UTC
# (e.g. 02:00-04:00 UTC = 21:00-23:00 the previous evening in America/New_York).
# Startup logs the resolved window.
# ROLLOUT_WINDOW_TZ=America/New_York

# How often to poll (Go duration: 5m, 15m, 1h). Default and minimum 5m; shorter
# values are clamped unless the agent runs with --dry-run (dev/test).
# POLL_INTERVAL=5m

# UPDATE_MODE selects how updates are gated: "always" applies every consensus
# version; "ai" lets the classifier sidecar read the release notes and alert when
# the operator must act first. This compose stack sets UPDATE_MODE=ai, so the
# classifier sidecar starts by default (~2 GB RAM). To skip it: UPDATE_MODE=always
# (and run with --scale laya=0). The agent binary's own default when UPDATE_MODE is
# unset is "always".


# Slack interactive approvals via Socket Mode (optional, no port exposure needed).
# Create an App-Level Token in your Slack App under Basic Information > App-Level Tokens
# with the "connections:write" scope, then paste the xapp-... token here.
# SLACK_APP_TOKEN=xapp-1-XXXXXXXXX-XXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
