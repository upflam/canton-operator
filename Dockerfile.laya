# Laya classifier sidecar, with the model checkpoint baked in at build time.
#
# Build:
#   docker build -f Dockerfile.laya -t validator-classifier:laya .
#
# Run standalone:
#   docker run -p 127.0.0.1:8000:8000 validator-classifier:laya

FROM python:3.12-slim AS base

# CPU-only torch first so laya doesn't pull CUDA (~4GB).
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir "laya>=0.3.28" "starlette>=0.37,<1" "uvicorn>=0.30,<1"

RUN python -c "import laya; laya.load('ameerhmz5/laya-modernbert-decision-90pct')"

COPY scripts/laya_serve.py /app/laya_serve.py

ENV LAYA_PORT=8000 \
    LAYA_HOST=0.0.0.0 \
    LAYA_MODEL=ameerhmz5/laya-modernbert-decision-90pct

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health',timeout=3)"

CMD ["python", "/app/laya_serve.py"]
